# Configuration API Gemini pour KetoCoachAI Lightning RAG
# Copiez ce fichier vers .env et ajoutez vos vraies clés

# === GOOGLE GEMINI API (Recommandation #1) ===
# 1. Allez sur https://makersuite.google.com/app/apikey
# 2. Créez une nouvelle API key
# 3. Copiez-la ci-dessous
GOOGLE_API_KEY=AIzaSyBxLrPvUq5O2KI4sfsbMLTF856V8Uf7TUQ

# === PINECONE VECTOR DATABASE ===
# 1. Créez compte sur https://pinecone.io
# 2. Créez projet "keto-coach-ai"
# 3. Récupérez vos clés
PINECONE_API_KEY=votre-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp-free

# === CONFIGURATION SERVEUR ===
NODE_ENV=production
PORT=3000

# === CONFIGURATION LIGHTNING RAG ===
CACHE_TTL=300000
EMBEDDING_CACHE_TTL=86400000
MAX_CACHE_SIZE=1000

# === LIMITES GEMINI (gratuit) ===
GEMINI_RATE_LIMIT=60 # requêtes/minute
GEMINI_MODEL=gemini-2.5-flash # Modèle disponible et ultra-performant
GEMINI_EMBEDDING_MODEL=text-embedding-004 # Embeddings gratuits

# === ALTERNATIVES (commentées) ===
# HUGGINGFACE_API_KEY=hf_votre-huggingface-key
# OPENAI_API_KEY=sk-votre-openai-key

# === MONITORING ===
LOG_LEVEL=info
ENABLE_METRICS=true
